# Copie para .env (chmod 600). NUNCA versione .env nem cole tokens em comandos/logs.
# Exibição em horário local; o banco grava sempre UTC.
TZ=America/Sao_Paulo

# Nível de log: DEBUG, INFO, WARNING, ERROR
E4T_LOG_LEVEL=INFO

# Laço do worker (segundos) e heartbeat local gravado no SQLite.
E4T_TICK_SECONDS=5
E4T_HEARTBEAT_SECONDS=60

# SQLite: wal (padrão). Se o PRoot apresentar erro de locking/WAL, use delete.
E4T_SQLITE_JOURNAL=wal

# Heartbeat externo (ex.: healthchecks.io). DESATIVADO até você fornecer o endpoint.
E4T_HEARTBEAT_ENABLED=0
E4T_HEARTBEAT_URL=
E4T_HEARTBEAT_EXTERNAL_SECONDS=300

# Retenção de backups locais.
E4T_BACKUP_DAILY_KEEP=7
E4T_BACKUP_WEEKLY_KEEP=4
