{
  "_comentario": "Teste contínuo da secretária virtual (envio real desligado). Ativar: cp config/jobs.secretaria-teste.json config/jobs.json && scripts/ctl.sh restart worker. Voltar ao padrão: rm config/jobs.json && scripts/ctl.sh restart worker.",
  "jobs": [
    {"job_id": "demo_timestamp", "kind": "demo_timestamp", "enabled": true, "interval_seconds": 300,
     "catchup": "latest", "max_attempts": 5, "timeout_seconds": 20, "external_effect": false},
    {"job_id": "backup_diario", "kind": "backup_local", "enabled": true, "interval_seconds": 86400,
     "catchup": "latest", "max_attempts": 3, "timeout_seconds": 60, "external_effect": false},
    {"job_id": "sec_healthz", "kind": "http_check", "enabled": true, "interval_seconds": 60,
     "catchup": "latest", "max_attempts": 3, "timeout_seconds": 20, "external_effect": false,
     "params": {"url": "http://127.0.0.1:3100/healthz", "http_timeout_seconds": 5, "expect_status": 200}},
    {"job_id": "sec_simulacao", "kind": "secretaria_simulacao", "enabled": true, "interval_seconds": 900,
     "catchup": "latest", "max_attempts": 3, "timeout_seconds": 170, "external_effect": false,
     "params": {"timeout_seconds": 150}},
    {"job_id": "sec_backup", "kind": "secretaria_backup", "enabled": true, "interval_seconds": 86400,
     "catchup": "latest", "max_attempts": 3, "timeout_seconds": 120, "external_effect": false}
  ]
}
